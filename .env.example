# ACE / CSKA CRM — environment template
#
# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Every value below is a placeholder. Generate real secrets locally; do not
# reuse any value from this file, from a document, or from a chat message.
#
#   cp .env.example .env
#
# Variables marked REQUIRED have no default: the stack refuses to start
# without them rather than falling back to something insecure.

# =============================================================================
# Development database
# =============================================================================

# REQUIRED
POSTGRES_DB=crm_dev
POSTGRES_USER=crm_dev

# REQUIRED. Generate locally, e.g.
#   openssl rand -base64 24
# or in PowerShell:
#   [Convert]::ToBase64String((1..24 | % { Get-Random -Max 256 }))
POSTGRES_PASSWORD=

# Published on 127.0.0.1 only.
POSTGRES_PORT=5432

# ICU locale for Cyrillic collation of customer names. Change only with a
# migration plan: altering collation after data exists can invalidate
# existing text indexes.
DB_ICU_LOCALE=ru-KZ

# =============================================================================
# Test database — separate credentials, ephemeral tmpfs storage
# Started explicitly: docker compose --profile test up -d postgres-test
# =============================================================================

TEST_POSTGRES_DB=crm_test
TEST_POSTGRES_USER=crm_test

# REQUIRED when using the test profile. Must differ from POSTGRES_PASSWORD so
# a misconfigured test run cannot authenticate against development data.
TEST_POSTGRES_PASSWORD=

TEST_POSTGRES_PORT=5433

# =============================================================================
# Application — consumed once the backend service exists (INF-00, after D-01)
# =============================================================================

# REQUIRED. Session signing key. Generate a fresh value per environment and
# rotate at handover (INF-08), so no credential known during development
# remains valid afterward.
APP_SECRET_KEY=

# Business timezone for display, report boundaries and recurrence expansion.
# Containers themselves run in UTC; this is an application-level setting.
BUSINESS_TIMEZONE=Asia/Almaty

# Comma-separated. No wildcard: the session uses credentialed cookies, and a
# wildcard origin with credentials is both rejected by browsers and unsafe.
ALLOWED_ORIGINS=http://localhost:5173

PUBLIC_BASE_URL=http://localhost:5173

# Session cookie attributes. SESSION_COOKIE_SECURE must be true wherever the
# application is served over TLS. It is false here only because local
# development runs over plain HTTP; the deployed profile overrides it.
SESSION_COOKIE_NAME=crm_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Password hashing cost. Review and record the basis for these values in
# INF-02 rather than accepting a library default silently.
PASSWORD_HASH_ALGORITHM=argon2id
PASSWORD_HASH_MEMORY_KIB=65536
PASSWORD_HASH_ITERATIONS=3
PASSWORD_HASH_PARALLELISM=4

# Sign-in and recovery throttling (INF-02).
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Backend port. Provisional pending D-01; keep in step with
# VITE_API_PROXY_TARGET in the frontend repository.
BACKEND_PORT=8000

# Worker sweep interval. Cleanup latency only — correctness must not depend
# on it. AC-02 has to pass with the worker stopped.
WORKER_SWEEP_INTERVAL_SECONDS=30

# =============================================================================
# Deliberately NOT configurable
# =============================================================================
#
# The five-minute reservation hold (BR-04) and the two-hour cancellation
# cutoff (BR-07) are confirmed business rules, not settings. They are fixed
# in application code with tests pinning them, so that no environment file can
# silently change a rule the owner approved and that AC-03 and AC-05 verify.
#
# Also absent by design: any Kaspi, bank, fiscalization, SMS or analytics
# credential. None of those integrations is authorized; see
# development/README.md section 2.
